- set_body_class "play"
- seat = @game.seat_number_for(session[:uid])
- seat_player = @game.get_player(seat)

.game-container{ id: "game-#{@game.id}"}
  .game-ui
    .seat-bar{ class: ["seat-#{seat}", ("single-device" if @game.single_device?)] }
      .seat-status
        .seat-led{ "aria-hidden": "true" }
          .seat-digit= seat.zero? ? "--" : seat
        .seat-text
          %span.seat-label= @game.seat_label_for(session[:uid])
          %span.seat-sep{ "aria-hidden": "true" } ·
          %input.name-input{ type: "text", maxlength: 24, placeholder: "Your name",
            "aria-label": "Your player name", value: seat_player&.name, hidden: seat.zero? }
          %span.seat-hint= @game.seat_hint
      .seat-controls
        .seat-switch{ role: "group", "aria-label": "Choose your seat" }
          - [[1, "Player 1"], [2, "Player 2"], [0, "Spectate"]].each do |number, label|
            %button.seat-option{ type: "button", class: "seat-option-#{number}",
              data: { number: number }, "aria-pressed": (number == seat).to_s }= label
        = link_to "Exit", root_path, class: "exit-link"
      .share
        %label.share-label{ for: "share-url-#{@game.id}" } Share
        %input.share-url{ id: "share-url-#{@game.id}", type: "text", readonly: true,
          value: request.original_url, "aria-label": "Link to this game" }
        %button.share-copy{ type: "button" } Copy
    .scoreboard
      - @game.players.each do |player|
        %div{class: player.div_class}
          .turn-indicator{class: player.indicator_class(@game)}= render "indicator"
          .logo= player.number
          .name= player.name
          .score-led
            .score= @game.score(player.number)
      .progress
        .light-track
          - @game.light_track_on.times do
            .scoreboard-light.on.flicker= render "light"
          - @game.light_track_off.times do
            .scoreboard-light= render "light"
  .board-area
    .notifications{ "aria-live": "polite" }
    = @game.board_div

.page-overlay
  .overlay-modal
    .title Dynamic
    .actions
      = link_to "Exit", root_path, class: "exit-link"
      = link_to "Restart", restart_game_path(@game), class: "restart-link"

= init_play_js(@game)
