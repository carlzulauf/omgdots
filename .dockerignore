# Keep the build context to what the image needs: the app, its config and
# the Gemfile. Assets are compiled inside the image (bin/build-assets.sh).
.git
.gitignore
.direnv
.env*
.claude
.ruby-lsp
.bundle
.byebug_history
.rspec
tmp
log
node_modules
public/assets
app/assets/builds/*
!app/assets/builds/.keep
db/dump.rdb
doc/changelog/media
spec
